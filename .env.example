# ========================================
# Hosted Server Configuration
# ========================================

# Server Port (default: 3000)
PORT=3000

# Valid API Keys for MCP Client Authentication (REQUIRED for hosted mode)
# Comma-separated list of API keys that clients (e.g., n8n) must provide via Authorization header
# Example: VALID_API_KEYS=secret-key-1,secret-key-2,secret-key-3
VALID_API_KEYS=your-api-key-1,your-api-key-2

# ========================================
# GitHub Configuration
# ========================================

# GitHub Personal Access Token (OPTIONAL for hosted mode)
# Can be set here as a fallback, or provided per-request via X-GitHub-Token header
# When using n8n, you can override this by sending X-GitHub-Token header with each request
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=llama3.1

# Review Configuration
PROMPT_FILE_PATH=./prompts/review-prompt.md
AUTO_POST_REVIEW=false

# Cursor Configuration (Optional - if using Cursor CLI)
CURSOR_CLI_PATH=cursor
CURSOR_DEFAULT_MODEL=gpt-4

# Gemini Configuration (Optional - if using Gemini CLI)
GEMINI_CLI_PATH=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-pro

# General Settings
MAX_PATCH_SIZE=2000
MAX_FILES_TO_REVIEW=50
REVIEW_TIMEOUT=300000

# Logging Configuration
LOG_LEVEL=info
ENABLE_DEBUG=false